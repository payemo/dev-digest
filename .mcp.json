{
  "mcpServers": {
    "devdigest": {
      "command": "npx",
      "args": ["tsx", "mcp/src/server.ts"],
      "env": {
        "DEVDIGEST_API_URL": "http://127.0.0.1:3001"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
