{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "sourceMap": true,
    "composite": false,
    "outDir": "dist",
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022"],
    "paths": {
      "@devdigest/shared": ["./src/vendor/shared/index.ts"],
      "@devdigest/shared/*": ["./src/vendor/shared/*"],
      "@devdigest/reviewer-core": ["../reviewer-core/src/index.ts"],
      "@devdigest/reviewer-core/*": ["../reviewer-core/src/*"]
    }
  },
  // test/** and vitest.config.ts are included so `pnpm typecheck` (tsc
  // --noEmit) actually checks the suite — it didn't before, which is how
  // several `as unknown as` casts in test/ went uncaught. `pnpm build` (tsc,
  // no --noEmit) will now also try to EMIT them into dist/ alongside src/;
  // harmless today since dist/server.js can't run regardless (see the
  // improvement plan's note on `build`/`start` being broken already), but
  // worth a dedicated build-only tsconfig if that gets fixed.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
